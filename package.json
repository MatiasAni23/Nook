{
  "name": "pinwi",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "start": "vite",
    "build": "vite build",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "emails:generate": "node scripts/generate-email-templates.mjs",
    "seo:check": "node scripts/check-seo-build.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev:phone": "vite --host 0.0.0.0",
    "build:mobile": "vite build --mode mobile",
    "mobile:icons": "node scripts/generate-mobile-icons.mjs",
    "mobile:sync": "npm run build:mobile && cap sync",
    "android:sync": "npm run build:mobile && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "android:run": "npm run android:sync && cap run android",
    "ios:sync": "npm run build:mobile && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "preview:phone": "vite preview --host 0.0.0.0 --port 4173"
  },
  "dependencies": {
