# dependencies
node_modules/

# Expo
.expo/
dist/
dist-mobile/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.keystore
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env
.env*.local

# Supabase CLI state and private local schema inspection results
supabase/.temp/
.local/supabase-audit/
supabase/schema/private/

# Local reports, data models and SQL (keep on disk, never publish)
/docs-local/
/supabase/schema/
/supabase/migrations/
*.[sS][qQ][lL]
*.[sS][qQ][lL].*

# typescript
*.tsbuildinfo

# Native projects are source; build products, machine paths and signing stay local.
android/.gradle/
android/.idea/
android/local.properties
android/**/build/
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json
android/app/src/main/assets/capacitor.plugins.json
android/capacitor-cordova-android-plugins/
ios/App/App/public/
ios/App/App/capacitor.config.json
ios/App/Pods/
ios/App/DerivedData/
ios/**/xcuserdata/
ios/capacitor-cordova-ios-plugins/
